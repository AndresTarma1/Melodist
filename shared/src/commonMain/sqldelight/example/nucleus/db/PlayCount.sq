CREATE TABLE IF NOT EXISTS PlayCount (
    song TEXT NOT NULL,
    year INTEGER NOT NULL DEFAULT -1,
    month INTEGER NOT NULL DEFAULT -1,
    count INTEGER NOT NULL DEFAULT -1,
    PRIMARY KEY (song, year, month)
);

selectBySong:
SELECT * FROM PlayCount WHERE song = ?;

lifetimePlayCount:
SELECT SUM(count) FROM PlayCount WHERE song = ?;

playCountByYear:
SELECT SUM(count) FROM PlayCount WHERE song = ? AND year = ?;

playCountByMonth:
SELECT count FROM PlayCount WHERE song = ? AND year = ? AND month = ?;

insertPlayCount:
INSERT OR REPLACE INTO PlayCount (song, year, month, count) VALUES (?, ?, ?, ?);

deletePlayCount:
DELETE FROM PlayCount WHERE song = ?;

-- ── Estadísticas ──

topSongs:
SELECT Song.*, SUM(PlayCount.count) AS playCount
FROM PlayCount
JOIN Song ON Song.id = PlayCount.song
GROUP BY PlayCount.song
ORDER BY playCount DESC
LIMIT ?;

topAlbums:
SELECT Song.albumName AS albumName, SUM(PlayCount.count) AS playCount
FROM PlayCount
JOIN Song ON Song.id = PlayCount.song
WHERE Song.albumName IS NOT NULL AND Song.albumName != ''
GROUP BY Song.albumName
ORDER BY playCount DESC
LIMIT ?;

topArtists:
SELECT Artist.*, SUM(PlayCount.count) AS playCount
FROM PlayCount
JOIN SongArtistMap ON SongArtistMap.songId = PlayCount.song
JOIN Artist ON Artist.id = SongArtistMap.artistId
GROUP BY Artist.id
ORDER BY playCount DESC
LIMIT ?;

